# Copy to .env and fill in. You need one web-search key and one LLM option.

# Web search (Serper primary, Google CSE fallback)
SERPER_API_KEY=
GOOGLE_CUSTOM_SEARCH_KEY=
GOOGLE_CSE_ID=

# LLM option A: Amazon Bedrock. Either point at an AWS profile with Bedrock access...
AWS_PROFILE=admin
AWS_REGION=us-east-1
# ...or use a Bedrock API key instead of a profile:
# AWS_BEARER_TOKEN_BEDROCK=

# LLM option B: direct vendor APIs
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
